{
  "expo": {
    "name": "Kalbub",
    "slug": "kalbub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kalbub",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.kalbub.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FBF3F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF3F4"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5D8F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4443f108-f1b1-4ddb-a112-c1a2cb3da2e2",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4443f108-f1b1-4ddb-a112-c1a2cb3da2e2"
      }
    },
    "owner": "akbar26"
  }
}
